function WebhookController:diffLoot()
if type(self._invStart) ~= "table" then return {} end
local now = snapshotInventory()
local gained = {}
for id, info in pairs(now) do
if not self._invStart[id] then
gained[#gained + 1] = info
end
end
return gained
end
function WebhookController:getUrl()
return FORCED_WEBHOOK_URL
end
function WebhookController:sendSummary()
local url = self:getUrl()
if url == "" then return false, "no url" end
local function safe(v)
v = tostring(v)
if v == nil or v == "" then return "-" end
return v
end
local totalGold = getLeaderstat("Gold")
local goldEarned = self._goldAtStart and (totalGold - self._goldAtStart) or 0
if goldEarned < 0 then goldEarned = 0 end
local totalGems = getLeaderstat("Gems")
local gemsEarned = self._gemsAtStart and (totalGems - self._gemsAtStart) or 0
if gemsEarned < 0 then gemsEarned = 0 end
local fields = {
{ name = "Gold Earned", value = safe("+" .. abbreviateNumber(goldEarned)), inline = true },
{ name = "Gems Earned", value = safe("+" .. abbreviateNumber(gemsEarned)), inline = true },
{ name = "Level",       value = safe(getLeaderstat("Level")),               inline = true },
}
local xp = getXPText()
if xp and xp ~= "" then
fields[#fields + 1] = { name = "XP", value = xp, inline = true }
end
fields[#fields + 1] = { name = "Total Gold", value = safe(abbreviateNumber(totalGold)), inline = true }
fields[#fields + 1] = { name = "Total Gems", value = safe(abbreviateNumber(totalGems)), inline = true }
fields[#fields + 1] = { name = "Dungeon",    value = safe(getCurrentDungeonName()), inline = true }
fields[#fields + 1] = { name = "Runs",       value = safe(StatsController.Runs), inline = true }
fields[#fields + 1] = { name = "Gold/hr",    value = safe(abbreviateNumber(StatsController:GoldPerHour())), inline = true }
fields[#fields + 1] = { name = "Session",    value = safe(StatsController:Runtime()), inline = true }
local items = self._loot
if #items == 0 then
items = self:diffLoot()
end
local lootLines = {}
for _, it in ipairs(items) do
if it.rarity and it.rarity ~= "" then
lootLines[#lootLines + 1] = ("**%s** (%s)"):format(it.name, it.rarity)
else
lootLines[#lootLines + 1] = ("**%s**"):format(it.name)
end
if #lootLines >= 25 then break end
end
local lootText = (#lootLines > 0) and table.concat(lootLines, "\n") or "No items"
fields[#fields + 1] = { name = "Items", value = lootText:sub(1, 1000), inline = false }
local payload = {
username = "Dexori",
embeds = { {
title = "Dungeon Complete",
color = 8388863,
fields = fields,
footer = { text = "Ryoichi is king glaze me" },
} },
}
local ok, body = pcall(function()
return game:GetService("HttpService"):JSONEncode(payload)
end)
if not ok then return false, "json encode failed" end
return httpRequest({
Url = url,
Method = "POST",
Headers = { ["Content-Type"] = "application/json" },
Body = body,
})
end
function WebhookController:Start()
self:Stop()
pcall(function() self:startLootHook() end)
self:resetRun()
self._sentThisRun = false
self._wasInDungeon = (workspace:FindFirstChild("dungeon") ~= nil)
self._conn = RunService.Heartbeat:Connect(function()
local inDungeon = workspace:FindFirstChild("dungeon") ~= nil
if inDungeon and not self._wasInDungeon then
self._goldAtStart = getLeaderstat("Gold")
self._gemsAtStart = getLeaderstat("Gems")
self._loot = {}
self._invStart = snapshotInventory()
self._sentThisRun = false
end
if inDungeon then
local pg = LocalPlayer:FindFirstChild("PlayerGui")
local menu = pg and pg:FindFirstChild("Menu")
local menuOpen = (menu and menu:IsA("ScreenGui") and menu.Enabled or false)
or isDungeonFinished()
if menuOpen and not self._sentThisRun then
self._sentThisRun = true
task.wait(2.5)
pcall(function() self:sendSummary() end)
self._goldAtStart = getLeaderstat("Gold")
self._gemsAtStart = getLeaderstat("Gems")
self._loot = {}
self._invStart = snapshotInventory()
elseif not menuOpen and self._sentThisRun and self._menuWasOpen then
self._sentThisRun = false
end
self._menuWasOpen = menuOpen
end
if self._wasInDungeon and not inDungeon and not self._sentThisRun then
self._sentThisRun = true
task.wait(1)
pcall(function() self:sendSummary() end)
end
self._wasInDungeon = inDungeon
end)
end
function WebhookController:Stop()
if self._conn then self._conn:Disconnect() self._conn = nil end
end
function WebhookController:SetEnabled(on)
self.Enabled = on
if on then self:Start() else self:Stop() end
end
