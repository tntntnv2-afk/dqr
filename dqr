local function getNearestMobRoot(fromPosition)
local nearestRoot, nearestDist = nil, math.huge
for _, mob in ipairs(getMobs()) do
if mob.Parent then
local root = mob:FindFirstChild("HumanoidRootPart")
or mob:FindFirstChild("hitBox")
or mob.PrimaryPart
or mob:FindFirstChildWhichIsA("BasePart")
if root then
local dist = (root.Position - fromPosition).Magnitude
if dist < nearestDist then
nearestDist = dist
nearestRoot = root
end
end
end
end
return nearestRoot
end
local function getNearestMobDistance(fromPosition)
local best = math.huge
for _, mob in ipairs(getMobs()) do
if mob.Parent then
local root = mob:FindFirstChild("HumanoidRootPart")
or mob:FindFirstChild("hitBox")
or mob.PrimaryPart
or mob:FindFirstChildWhichIsA("BasePart")
if root then
local d = (root.Position - fromPosition).Magnitude
if d < best then best = d end
end
end
end
return best
end
