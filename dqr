local ABBR_SUFFIX = { "", "k", "m", "b", "t", "qa", "qi", "sx", "sp" }
local function abbreviateNumber(n)
n = tonumber(n) or 0
local neg = n < 0
local v = math.abs(n)
if v < 1000 then
return (neg and "-" or "") .. tostring(math.floor(v))
end
local idx = math.floor(math.log(math.max(1, v), 1000))
local suffix = ABBR_SUFFIX[idx + 1] or ("e+" .. idx)
local scaled = v / (1000 ^ idx)
scaled = math.floor(scaled * 100) / 100
local str = string.format("%.2f", scaled):gsub("%.?0+$", "")
return (neg and "-" or "") .. str .. suffix
end
