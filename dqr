local function rarityFromKey(key)
if type(key) ~= "string" then return "" end
local k = key:lower()
for _, r in ipairs({ "common", "uncommon", "rare", "epic", "legendary", "ultimate" }) do
if k:find(r) then return r end
end
return key
end
local function lookupItemName(itemType, uniqueNum)
local ok, storage = pcall(function()
local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("remotes")
local fn = remotes and (remotes:FindFirstChild("reloadInvy")
or remotes:FindFirstChild("getPlayerStorage"))
return fn and fn:InvokeServer()
end)
if not ok or type(storage) ~= "table" then return nil end
local bucketByType = {
weapon = "weapons", ability = "abilities", chest = "chests", helmet = "helmets",
}
local bucket = storage[bucketByType[itemType] or ""]
if type(bucket) == "table" then
for _, item in pairs(bucket) do
if type(item) == "table"
and tonumber(item.uniqueItemNum) == tonumber(uniqueNum) then
return item.name
end
end
end
return nil
end
function WebhookController:startLootHook()
if self._lootHook then return end
local ok, remotes = pcall(function()
return game:GetService("ReplicatedStorage"):FindFirstChild("remotes")
end)
local fn = ok and remotes and remotes:FindFirstChild("addItemToInvy")
if not fn then return end
self._lootHook = true
local this = self
local function record(itemType, uniqueNum, rarityKey)
pcall(function()
local name = lookupItemName(itemType, uniqueNum) or tostring(itemType)
local rar = rarityFromKey(rarityKey)
this._loot[#this._loot + 1] = { name = name, rarity = rar }
if this.PingRares and (rar == "legendary" or rar == "ultimate") then
task.spawn(function()
local url = this:getUrl()
if url == "" then return end
local body = game:GetService("HttpService"):JSONEncode({
username = "Dexori",
embeds = { {
title = "Rare Drop!",
description = ("**%s** (%s)"):format(name, rar),
color = 16766720,
footer = { text = "Ryoichi is king glaze me" },
} },
})
httpRequest({
Url = url,
Method = "POST",
Headers = { ["Content-Type"] = "application/json" },
Body = body,
})
end)
end
end)
end
local hooked = false
local original
pcall(function()
if type(getcallbackvalue) == "function" then
original = getcallbackvalue(fn, "OnClientInvoke")
end
end)
local okSet = pcall(function()
fn.OnClientInvoke = function(itemType, uniqueNum, imageId, rarityKey)
record(itemType, uniqueNum, rarityKey)
if type(original) == "function" then
return original(itemType, uniqueNum, imageId, rarityKey)
end
end
end)
if okSet then hooked = true end
if not hooked and type(hookmetamethod) == "function" and type(newcclosure) == "function" then
pcall(function()
local old
old = hookmetamethod(game, "__namecall", newcclosure(function(self2, ...)
local method = getnamecallmethod and getnamecallmethod() or ""
if self2 == fn and (method == "InvokeClient" or method == "OnClientInvoke") then
local args = { ... }
record(args[1], args[2], args[4])
end
return old(self2, ...)
end))
hooked = true
end)
end
if not hooked then
self._lootHook = nil
end
end
local function snapshotInventory()
local ids = {}
pcall(function()
local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("remotes")
local fn = remotes and remotes:FindFirstChild("reloadInvy")
local inv = fn and fn:InvokeServer()
if type(inv) ~= "table" then return end
for bucketName, itemType in pairs({ weapons = "weapon", abilities = "ability",
chests = "chest", helmets = "helmet" }) do
local bucket = inv[bucketName]
if type(bucket) == "table" then
for key, item in pairs(bucket) do
if type(item) == "table" then
local uid = itemType .. ":" .. tostring(key)
ids[uid] = {
name = item.name or itemType,
rarity = (item.rarity and tostring(item.rarity):lower()) or "",
}
end
end
end
end
end)
return ids
end
