function LobbyController:pickHighestDungeon()
local myLevel = getPlayerLevel()
local ceiling = difficultyIndex(self.Difficulty)
local anyStats = false
local skip = self._skip or {}
if self.BestGold and StatsController.PerDungeon then
local bestName, bestDiff, bestRate = nil, nil, -1
for _, name in ipairs(self.Dungeons) do
local d = StatsController.PerDungeon[name]
if d and d.n > 0 and not skip[name] then
local diff = bestEntryForDungeon(name, ceiling, myLevel)
if diff and d.rate > bestRate then
bestRate = d.rate
bestName = name
bestDiff = diff
end
end
end
if bestName then
return bestName, bestDiff, (getDungeonLevelReq(bestName, bestDiff) or 0),
("best gold/hr: " .. bestName .. " on " .. bestDiff ..
" (~" .. abbreviateNumber(bestRate) .. "/hr)")
end
end
local best, bestDiff, bestReq = nil, nil, -1
for _, name in ipairs(self.Dungeons) do
if not skip[name] then
for i = 1, #DIFFICULTY_ORDER do
if getDungeonLevelReq(name, DIFFICULTY_ORDER[i]) ~= nil then
anyStats = true; break
end
end
local diff, req = bestEntryForDungeon(name, ceiling, myLevel)
if diff and req > bestReq then
bestReq = req
bestDiff = diff
best = name
end
end
end
if best then
return best, bestDiff, bestReq,
("highest you qualify for: " .. best .. " on " .. bestDiff ..
" (req " .. bestReq .. ", you " .. myLevel .. ")")
end
if not anyStats then
return nil, nil, nil, "no dungeon stats returned (getDungeonStats failed)"
end
return nil, nil, nil, "nothing within your level at or below " .. self.Difficulty
end
function LobbyController:startDungeon(name, difficulty)
difficulty = difficulty or self.Difficulty
local remotes = getRemotes()
local createLobby = remotes:FindFirstChild("createLobby")
local startDungeon = remotes:FindFirstChild("startDungeon")
if not createLobby then return false end
local levelReq = getDungeonLevelReq(name, difficulty) or 0
notify({ Title = "Start Dungeon", Description = tostring(name) .. " | " .. tostring(difficulty) .. " | req " .. tostring(levelReq), Time = 4 })
local created = false
pcall(function()
created = createLobby:InvokeServer(
name, difficulty, levelReq,
self.Hardcore, self.Private, self.WaveDefence
) == true
end)
if created and startDungeon then
task.wait(0.5)
pcall(function() startDungeon:FireServer() end)
end
return created
end
function LobbyController:_demote()
self._fails = 0
if self.Hardcore then
self.Hardcore = false
pcall(function() if Toggles.Hardcore then Toggles.Hardcore:SetValue(false) end end)
notify({ Title = "Smart Play", Description = "Too many fails - turned off Hardcore", Time = 5 })
return
end
local idx = difficultyIndex(self.Difficulty)
if idx > 1 then
self.Difficulty = DIFFICULTY_ORDER[idx - 1]
pcall(function() if Options.Difficulty then Options.Difficulty:SetValue(self.Difficulty) end end)
notify({ Title = "Smart Play", Description = "Dropped difficulty to " .. self.Difficulty, Time = 5 })
return
end
self._skip = self._skip or {}
if self.LastPick then
self._skip[self.LastPick] = true
notify({ Title = "Smart Play", Description = "Skipping " .. self.LastPick .. " - too hard", Time = 5 })
end
end
function LobbyController:reportRunResult(won)
if not self.SmartPlay then return end
if won then
self._fails = 0
else
self._fails = (self._fails or 0) + 1
if self._fails >= (self.FailLimit or 3) then
self:_demote()
end
end
end
function LobbyController:PlayNow()
