local function isMobAttackingNear(pos, range)
for _, part in ipairs(getTelegraphParts()) do
if part.Parent then
local active = part.Transparency < 0.95
if active and (part.Position - pos).Magnitude <= range then
return true
end
end
end
return false
end
local function nearestTelegraphDist(pos)
local best = math.huge
for _, part in ipairs(getTelegraphParts()) do
if part.Parent and part.Transparency < 0.95 then
local d = (part.Position - pos).Magnitude
if d < best then best = d end
end
end
return best
end
local function telegraphRadius(part)
local s = part.Size
local r = math.max(s.X, s.Z) * 0.5
local n = part.Name:lower()
if n:find("tentacle") or n:find("kraken") or n:find("swing")
or n:find("slam") or n:find("blade") then
r = r + 18
end
return r
end
local function spotIsClear(pos, margin)
margin = margin or 16
local flat = Vector2.new(pos.X, pos.Z)
for _, part in ipairs(getTelegraphParts()) do
if part.Parent and part.Transparency < 0.95 then
local pflat = Vector2.new(part.Position.X, part.Position.Z)
if (pflat - flat).Magnitude <= telegraphRadius(part) + margin then
return false
end
end
end
return true
end
local ATTACK_RANGE = 42
local SAFE_CLEARANCE = 18
local function findAttackSafeSpot(target, offset, below)
local mobPos = target.Position
local yOff = below and -offset or offset
local candidates = {
mobPos + Vector3.new(0, yOff, 0),
mobPos,
mobPos + Vector3.new(0, -offset, 0),
mobPos + Vector3.new(0, offset, 0),
}
for _, radius in ipairs({ 6, 10, 15, 20, 26, 32, 40 }) do
for a = 0, 7 do
local angle = (a / 8) * math.pi * 2 + math.random() * 0.3
candidates[#candidates + 1] =
mobPos + Vector3.new(math.cos(angle) * radius, yOff, math.sin(angle) * radius)
end
end
for _, clearance in ipairs({ SAFE_CLEARANCE, 13, 9, 6 }) do
local best, bestDist = nil, math.huge
for _, c in ipairs(candidates) do
local d = (c - mobPos).Magnitude
if d <= ATTACK_RANGE and spotIsClear(c, clearance) then
if d < bestDist then bestDist = d; best = c end
end
end
if best then return best end
end
for _, radius in ipairs({ 55, 70, 90, 115, 145 }) do
for a = 0, 7 do
local angle = (a / 8) * math.pi * 2 + math.random() * 0.3
candidates[#candidates + 1] =
mobPos + Vector3.new(math.cos(angle) * radius, yOff, math.sin(angle) * radius)
end
end
local best, bestDist = nil, math.huge
for _, c in ipairs(candidates) do
if spotIsClear(c, 14) then
local d = (c - mobPos).Magnitude
if d < bestDist then bestDist = d; best = c end
end
end
if best then return best end
local far, farScore = nil, -1
for _, c in ipairs(candidates) do
local clear = nearestTelegraphDist(c)
if clear > farScore then farScore = clear; far = c end
end
return far or (mobPos + Vector3.new(0, yOff, 0))
end
