local EquipController = { Enabled = false, Build = "physical", _thread = nil }
local function rawStat(item, itemType, build)
if itemType == "weapon" then
if build == "mage" then
return tonumber(item.spellPower) or tonumber(item.spellDamage)
or tonumber(item.physicalDamage) or tonumber(item.damage) or 0
end
return tonumber(item.physicalDamage) or tonumber(item.damage)
or tonumber(item.spellPower) or 0
end
local d = tonumber(item.defence) or 0
local h = tonumber(item.health) or 0
local extra = 0
if build == "mage" then
extra = tonumber(item.spellPower) or 0
else
extra = tonumber(item.physicalDamage) or 0
end
return d + h * 0.5 + extra
end
local RARITY_MULT = {
common = 1, uncommon = 1.15, rare = 1.35, epic = 1.6,
legendary = 2, ultimate = 2.5,
}
local function projectedMaxPower(item, itemType, build)
local base = rawStat(item, itemType, build)
if base <= 0 then return 0 end
local cur = tonumber(item.currentUpgrade) or 0
local max = tonumber(item.maxUpgrades) or 0
local perLevel = 0.08
local projected
if max > 0 and cur >= 0 then
local baseAtZero = base / (1 + cur * perLevel)
projected = baseAtZero * (1 + max * perLevel)
else
projected = base
end
local rar = item.rarity and tostring(item.rarity):lower() or ""
projected = projected * (RARITY_MULT[rar] or 1)
return projected
end
