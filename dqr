local function bestEntryForDungeon(name, ceilingIndex, myLevel)
local chosenDiff, chosenReq = nil, -1
for i = 1, ceilingIndex do
local diff = DIFFICULTY_ORDER[i]
local req = getDungeonLevelReq(name, diff)
if req ~= nil and req <= myLevel and req > chosenReq then
