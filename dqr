function AutomationController:_tryRetry()
local finished = isDungeonFinished()
if finished and not self._retriedThisRun then
self._retriedThisRun = true
task.spawn(function()
task.wait(3)
if not isDungeonFinished() then return end
local data = collectDungeonData()
if not data.dungeonName then
notify({ Title = "Auto Retry", Description = "no dungeon data to replay", Time = 5 })
return
end
local remotes = getRemotes()
local replay = remotes:FindFirstChild("replayDungeon")
if replay then
pcall(function() replay:FireServer(data) end)
notify({ Title = "Auto Retry", Description = "Replaying " .. tostring(data.dungeonName), Time = 3 })
else
notify({ Title = "Auto Retry", Description = "replayDungeon remote missing", Time = 5 })
end
end)
return
end
if not finished then
self._retriedThisRun = false
end
if os.clock() - self._lastRetry < 1.5 then return end
local yes = findGuiButtonIn("ReplayConfirmation", function(path)
return path:find("confirm")
end)
if yes then
self._lastRetry = os.clock()
clickButton(yes)
return
end
local replay = findGuiButtonIn("Menu", function(path)
return path:find("replaybutton")
end)
if replay then
self._lastRetry = os.clock()
clickButton(replay)
end
end
function AutomationController:_tryNextTier()
if os.clock() - self._lastRetry < 1.5 then return end
local yes = findGuiButtonIn("ReplayConfirmation", function(path)
return path:find("confirm")
end)
if yes then
self._lastRetry = os.clock()
clickButton(yes)
notify({ Title = "Next Tier", Description = "Clicked YES", Time = 2 })
return
end
local nextTier = findGuiButtonIn("Menu", function(path)
return path:find("nexttierbutton")
end)
if nextTier then
self._lastRetry = os.clock()
clickButton(nextTier)
notify({ Title = "Next Tier", Description = "Clicked Next Tier", Time = 2 })
end
end
