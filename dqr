local buckets = { weapons = "weapon", chests = "chest", helmets = "helmet" }
for bucketName, itemType in pairs(buckets) do
local bucket = inv[bucketName]
if type(bucket) == "table" then
local best, bestPow, equippedNum, equippedPow = nil, -1, nil, 0
for _, item in pairs(bucket) do
if type(item) == "table" then
local pow = projectedMaxPower(item, itemType, self.Build)
if item.equipped == true then
equippedNum = tonumber(item.uniqueItemNum)
equippedPow = pow
end
if pow > bestPow then
bestPow = pow
best = tonumber(item.uniqueItemNum)
end
end
end
if best and best ~= equippedNum and bestPow > equippedPow * 1.02 then
pcall(function() equip:InvokeServer(itemType, best) end)
task.wait(0.3)
end
end
end
end
