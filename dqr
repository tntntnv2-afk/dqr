local function spotIsClearEx(pos, margin, ignoreFresh)
	margin = margin or 16
	local flat = Vector2.new(pos.X, pos.Z)
	for _, part in ipairs(getTelegraphParts()) do
		if part.Parent and part.Transparency < 0.95 and (ignoreFresh or partIsFreshThreat(part)) then
			local s = part.Size
			local rdx = pos.X - part.Position.X
			local rdz = pos.Z - part.Position.Z
			local reach = math.max(s.X, s.Z) * 0.5 + margin + 10
			if rdx * rdx + rdz * rdz <= reach * reach then
			local cf = part.CFrame
			local longAxis = math.max(s.X, s.Z)
			local shortAxis = math.min(s.X, s.Z)
			local isLong = longAxis > shortAxis * 3 and longAxis > 20
			local horizR = isLong and (shortAxis * 0.5) or telegraphRadius(part)
			local vHalf = math.abs(cf.UpVector.Y) * s.Y * 0.5
				+ math.abs(cf.RightVector.Y) * s.X * 0.5
				+ math.abs(cf.LookVector.Y) * s.Z * 0.5
			if pos.Y > part.Position.Y + vHalf + math.max(isLong and 18 or 12, horizR + margin) then
			else
			if isLong then
				local dir = (s.X >= s.Z) and cf.RightVector or cf.LookVector
				local dirFlat = Vector2.new(dir.X, dir.Z)
				if dirFlat.Magnitude < 0.5 then
					local extX = math.abs(cf.RightVector.X) * s.X * 0.5 + math.abs(cf.UpVector.X) * s.Y * 0.5 + math.abs(cf.LookVector.X) * s.Z * 0.5
					local extZ = math.abs(cf.RightVector.Z) * s.X * 0.5 + math.abs(cf.UpVector.Z) * s.Y * 0.5 + math.abs(cf.LookVector.Z) * s.Z * 0.5
					local fr = math.max(extX, extZ)
					local pflat = Vector2.new(part.Position.X, part.Position.Z)
					if (pflat - flat).Magnitude <= fr + margin then
						return false
					end
				else
					dirFlat = dirFlat.Unit
					local center = Vector2.new(part.Position.X, part.Position.Z)
					local rel = flat - center
					local along = rel.X * dirFlat.X + rel.Y * dirFlat.Y
					local half = longAxis * 0.5
					if along > half then along = half elseif along < -half then along = -half end
					local closest = center + dirFlat * along
					if (flat - closest).Magnitude <= shortAxis * 0.5 + margin then
						return false
					end
				end
			else
				local pflat = Vector2.new(part.Position.X, part.Position.Z)
				if (pflat - flat).Magnitude <= telegraphRadius(part) + margin then
					return false
				end
			end
			end
			end
		end
