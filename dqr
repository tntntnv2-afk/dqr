self:startDungeon(self.SelectedDungeon, diff)
return self.SelectedDungeon, diff
end
end
local SELL_DEBUG = "?"
local SellController = {
Enabled = false,
MaxRarity = "rare",
_conn = nil,
}
local RARITY_ORDER = { "common", "uncommon", "rare", "epic", "legendary", "ultimate" }
local function rarityRank(name)
if type(name) ~= "string" then return 999 end
local n = name:lower()
for i, r in ipairs(RARITY_ORDER) do
if r == n then return i end
end
return 999
end
local function isUnequipped(item)
local eq = item.equipped
if eq == nil then return true end
if type(eq) == "table" then
return (eq.q ~= true) and (eq.e ~= true)
end
return eq == false
end
local function buildSellPayload(maxRank)
local remotes = getRemotes()
local storage
local invFn = remotes:FindFirstChild("reloadInvy")
if invFn then
local ok, res = pcall(function() return invFn:InvokeServer() end)
if ok and type(res) == "table" then storage = res end
end
if not storage then
local fn = remotes:FindFirstChild("getPlayerStorage")
if fn then
local ok, res = pcall(function() return fn:InvokeServer() end)
if ok and type(res) == "table" then storage = res end
end
end
if type(storage) ~= "table" then return nil, "inventory unavailable" end
local payload = { weapon = {}, ability = {}, chest = {}, helmet = {} }
local buckets = {
weapons   = { t = "weapon",  numStart = 8 },
abilities = { t = "ability", numStart = 9 },
chests    = { t = "chest",   numStart = 7 },
helmets   = { t = "helmet",  numStart = 8 },
}
local count, totalSeen, bucketsFound = 0, 0, 0
for bucketName, info in pairs(buckets) do
local bucket = storage[bucketName]
if type(bucket) == "table" then
bucketsFound = bucketsFound + 1
for key, item in pairs(bucket) do
if type(item) == "table" then
totalSeen = totalSeen + 1
local rank = rarityRank(item.rarity)
if isUnequipped(item) and rank <= maxRank then
local num = tonumber(item.uniqueItemNum)
or tonumber(tostring(key):match("(%d+)$"))
or tonumber(tostring(key):sub(info.numStart))
if num then
table.insert(payload[info.t], num)
count = count + 1
end
end
end
end
end
end
SELL_DEBUG = string.format("buckets:%d items:%d match:%d", bucketsFound, totalSeen, count)
return payload, count
end
function SellController:SellOnce()
local bt = LocalPlayer:FindFirstChild("busyTrading")
if bt and bt.Value == true then
return 0, "busy trading"
end
local maxRank = rarityRank(self.MaxRarity)
local payload, countOrErr = buildSellPayload(maxRank)
if not payload then return 0, countOrErr end
if countOrErr == 0 then return 0, "no items at/below " .. self.MaxRarity end
local remotes = getRemotes()
local sell = remotes:FindFirstChild("sellItemEvent")
if not sell then return 0, "sellItemEvent missing" end
local ok, err = pcall(function() sell:FireServer(payload) end)
if not ok then return 0, "fire failed: " .. tostring(err) end
return countOrErr
end
function SellController:Start()
self:Stop()
self._conn = task.spawn(function()
while true do
if workspace:FindFirstChild("dungeon") == nil then
local sold, err = self:SellOnce()
if (not sold or sold == 0) and err and not tostring(err):find("no items") then
notify({ Title = "Auto Sell", Description = tostring(err), Time = 5 })
end
end
task.wait(6)
end
end)
end
function SellController:Stop()
if self._conn then task.cancel(self._conn); self._conn = nil end
end
function SellController:SetEnabled(on)
self.Enabled = on
if on then self:Start() else self:Stop() end
end
