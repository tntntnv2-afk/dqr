self.SessionStart = os.time()
self:GoldEarned()
self.PerDungeon = self.PerDungeon or {}
self._runStart = nil
self._runGold = nil
self._runName = nil
self._wasInDungeon = workspace:FindFirstChild("dungeon") ~= nil
local persisted = loadPersist()
local SESSION_GAP = 300
local sameSession = persisted.SessionStart
and (os.time() - persisted.SessionStart) < SESSION_GAP
and (os.time() - (persisted.LastSeen or persisted.SessionStart)) < SESSION_GAP
if sameSession then
if persisted.Runs then self.Runs = persisted.Runs end
if persisted.SessionStart then self.SessionStart = persisted.SessionStart end
if type(persisted.PerDungeon) == "table" then self.PerDungeon = persisted.PerDungeon end
else
self.Runs = 0
self.SessionStart = os.time()
self.PerDungeon = {}
end
local function persist()
local d = loadPersist()
d.Runs = self.Runs
d.SessionStart = self.SessionStart
d.PerDungeon = self.PerDungeon
d.LastSeen = os.time()
savePersist(d)
end
persist()
self._conn = RunService.Heartbeat:Connect(function()
local nowT = os.time()
if nowT - (self._lastSeenSave or 0) >= 10 then
self._lastSeenSave = nowT
pcall(function()
